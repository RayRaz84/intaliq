        },
        {
          "id": "c_s02",
          "kind": "sentence",
          "ref": "s02",
          "text": "يَذْهَبُ يُوسُف إِلَى أُخْتِهِ. «يَا لَيْلَى، هَلْ عِنْدَكِ الْكُرَةُ؟»",
