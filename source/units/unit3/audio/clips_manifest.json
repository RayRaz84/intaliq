        },
        {
          "id": "c_s04",
          "kind": "sentence",
          "ref": "s04",
          "text": "«كِتَابِي؟ كِتَابِي لَيْسَ عِنْدِي. أُمِّي عِنْدَهَا كِتَابِي.»",
